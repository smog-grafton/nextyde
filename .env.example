# Telegram (required)
TG_API_ID=0
TG_API_HASH=replace_with_telegram_api_hash
TG_PHONE=
# Optional: session name (default: narabox_data_pipe)
TG_SESSION_NAME=narabox_telebot
# Optional: if 2FA is enabled
TG_2FA_PASSWORD=
# Optional: for headless first-time login (e.g. Docker)
TG_LOGIN_CODE=

# Watch / join targets (comma-separated)
# e.g. @jozzmovies or https://t.me/+invitehash
TG_WATCH_TARGETS=@jozzmovies
TG_JOIN_TARGETS=

# Paths
TEMP_DIR=/tmp/telebot
DB_PATH=./telebot_state.db
PORT=8765

# Logging
LOG_LEVEL=INFO

# Concurrency and scan
MAX_CONCURRENT_DOWNLOADS=1
MAX_CONCURRENT_TRANSCODES=1
WEB_MAX_ACTIVE_JOBS=2
WEB_RECENT_JOB_RETENTION_HOURS=24
# Messages to scan on startup (0 = only new messages and pasted links, no catch-up)
SCAN_LAST_MESSAGES=15
DOWNLOAD_CHUNK_SIZE=1048576
POLL_INTERVAL_SECONDS=30

# Cleanup
DELETE_AFTER_UPLOAD=true
TEMP_FILE_TTL_HOURS=24

# Download-only mode: no CDN upload; telebot fetches the original Telegram file and exposes a temp link you can paste into another fetch tool, then click Destroy
DOWNLOAD_ONLY=false
# When using Download only: public URL of this app so the temp file link works.
# Use the same URL you use in the browser to open the Web UI (with or without trailing slash).
# Examples: https://teletyde.example.com   https://myapp.157.173.104.218.sslip.io
TEMP_PUBLIC_URL=
# Optional secret for signed temp URLs used by CDN_HANDOFF_MODE=source_url.
# If blank, the app reuses CDN_API_TOKEN.
TEMP_URL_SECRET=

# Video preparation (used for normal upload/handoff jobs; download-only keeps the original Telegram file as-is)
VIDEO_PREP_ENABLED=true
VIDEO_PREP_MAX_HEIGHT=720
VIDEO_PREP_CRF=22
VIDEO_PREP_PRESET=superfast
VIDEO_PREP_MIN_SIZE_MB_FOR_TRANSCODE=50
VIDEO_PREP_TARGET_MAX_MB=1024
VIDEO_PREP_CAP_HEIGHT_LADDER=480,360
VIDEO_PREP_KEEP_ORIGINAL_ON_SUCCESS=false
VIDEO_PREP_TIMEOUT_SECONDS=21600
# Optional binary overrides (otherwise resolved from PATH)
FFMPEG_BINARY=
FFPROBE_BINARY=

# NBX pull handoff: Teletyde sends metadata, then NBX fetches the signed temp URL.
CDN_UPLOAD_URL=http://127.0.0.1:8012/api/v1/media/telegram-handoff
CDN_STREAM_UPLOAD_URL=http://127.0.0.1:8012/api/v1/media/telegram-stream-intake
CDN_API_TOKEN=replace_with_rotated_nbx_api_token
CDN_TIMEOUT_SECONDS=3600
CDN_SOURCE=telegram
CDN_HANDOFF_MODE=source_url
# Options: upload, path_copy, source_url, stream
CDN_SHARED_INTAKE_ROOT=/Applications/XAMPP/xamppfiles/htdocs/ffmpeg-worker/storage/app/telegram-intake
CDN_SHARED_INTAKE_DISK=telegram-intake
WORKER_HANDLES_VIDEO_PREP=true
# Optional: run the web app as a temp-file server only, without logging in to Telegram.
WEB_DISABLE_TELEGRAM=false
WORKER_API_TOKEN=

# Portal: ingest-notify endpoint (optional)
CDN_NOTIFY_URL=http://127.0.0.1:8000/api/telegram/ingest-notify
CDN_NOTIFY_TOKEN=replace_with_rotated_notify_token

# Telescope: persistent direct Telegram -> S3-compatible object storage.
# This is independent from the legacy Tele-OB/NBX path above.
TELESCOPE_ENABLED=false
TELESCOPE_DEFAULT_STORAGE_TARGET=auto
TELESCOPE_MAX_ACTIVE_JOBS=4
TELESCOPE_MAX_DOWNLOADS_PER_CHANNEL=2
TELESCOPE_MULTIPART_PART_SIZE_MB=32
TELESCOPE_MULTIPART_MAX_ATTEMPTS=4
TELESCOPE_UPLOAD_RETRY_BASE_MS=1000
TELESCOPE_CALLBACK_URL=https://portal.example.com/api/v1/teletyde/storage-events
TELESCOPE_CALLBACK_SECRET=replace_with_a_long_random_shared_secret
TELESCOPE_CALLBACK_TIMEOUT_SECONDS=30

# Logical target names match Portal/NBX. Credentials live only on Teletyde.
CONTABO_NBX_ENABLED=false
CONTABO_NBX_WRITABLE=true
CONTABO_NBX_ENDPOINT=https://usc1.contabostorage.com
CONTABO_NBX_REGION=US-central
CONTABO_NBX_BUCKET=nbx
CONTABO_NBX_PUBLIC_URL=
CONTABO_NBX_PATH_PREFIX=videos
CONTABO_NBX_USE_PATH_STYLE_ENDPOINT=true
CONTABO_NBX_ACCESS_KEY_ID=
CONTABO_NBX_SECRET_ACCESS_KEY=
CONTABO_NBX_CAPACITY_BYTES=536870912000
CONTABO_NBX_RESERVE_PERCENT=10
CONTABO_NBX_PRIORITY=20
CONTABO_NBX_KNOWN_USED_BYTES=0

CONTABO_NB_NBX_ENABLED=false
CONTABO_NB_NBX_WRITABLE=true
CONTABO_NB_NBX_ENDPOINT=https://usc1.contabostorage.com
CONTABO_NB_NBX_REGION=US-central
CONTABO_NB_NBX_BUCKET=nb-nbx
CONTABO_NB_NBX_PUBLIC_URL=
CONTABO_NB_NBX_PATH_PREFIX=videos
CONTABO_NB_NBX_USE_PATH_STYLE_ENDPOINT=true
CONTABO_NB_NBX_ACCESS_KEY_ID=
CONTABO_NB_NBX_SECRET_ACCESS_KEY=
CONTABO_NB_NBX_CAPACITY_BYTES=536870912000
CONTABO_NB_NBX_RESERVE_PERCENT=10
CONTABO_NB_NBX_PRIORITY=100
CONTABO_NB_NBX_KNOWN_USED_BYTES=0

CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_WRITABLE=true
CLOUDFLARE_R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=nbx
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_PATH_PREFIX=videos
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_CAPACITY_BYTES=10995116277760
CLOUDFLARE_R2_RESERVE_PERCENT=5
CLOUDFLARE_R2_PRIORITY=200
CLOUDFLARE_R2_KNOWN_USED_BYTES=0

# Defaults for metadata (optional)
DEFAULT_CATEGORY=
DEFAULT_LANGUAGE=
DEFAULT_VJ=
